{
  "name": "own-ui",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm registry:build && tsc --noEmit && vite build && node scripts/copy-docs.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "delivery:build": "node scripts/build-delivery.mjs",
    "registry:build": "pnpm delivery:build && pnpm dlx shadcn@4.21.4 build",
    "predev": "pnpm registry:build",
    "check:delivery": "node scripts/check-delivery.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-table": "8.21.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
